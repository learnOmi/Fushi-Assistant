<?xml version="1.0" encoding="utf-8"?>
<!--
  便携发布配置（M4d）：单文件 + 自包含 win-x64。
  用法：dotnet publish FuShi\src\FuShi.App -p:PublishProfile=Portable
  说明：
  - PublishTrimmed 必须为 false（WPF 不支持裁剪）；
  - IncludeNativeLibrariesForSelfExtract 保证 SQLite 原生库被压进单文件；
  - 数据库与日志仍落在 %APPDATA%\FuShi，不随发布目录迁移。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 不把被引用项目的 .pdb / .xml 复制进发布目录：便携包只留可执行文件 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
