<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         结构性令牌：不随主题变化（M3.5 实施计划 §8.1）
         只放尺寸、字阶、字体；颜色与材质一律在 Light / Dark 里。
         ============================================================ -->

    <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- 四档字阶：正文 / 次级 / 说明 / 微标 -->
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">12.5</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11.5</sys:Double>
    <sys:Double x:Key="FontSizeMicro">10</sys:Double>

    <!-- 关键度量：改这里即全局生效，避免布局里散落魔法数 -->
    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="ToolbarHeight">34</sys:Double>
    <sys:Double x:Key="SegmentedHeight">28</sys:Double>
    <sys:Double x:Key="CellMinHeight">66</sys:Double>

    <!-- 无边框窗口的可缩放热区（四边各 6px）。类型必须是 Thickness：
         WindowChrome.ResizeBorderThickness 不收 Double，传错会在加载期抛类型转换异常。 -->
    <Thickness x:Key="WindowResizeBorderThickness">6</Thickness>

    <Style x:Key="AppTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

</ResourceDictionary>
