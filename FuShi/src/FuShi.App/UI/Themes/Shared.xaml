<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         结构性令牌：不随主题变化（M3.5 实施计划 §8.1）
         只放尺寸、字阶、字体；颜色与材质一律在 Light / Dark 里。
         ============================================================ -->

    <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- 时刻与数字：Bahnschrift 的等宽数字让列对齐；缺失时回退 Segoe UI -->
    <FontFamily x:Key="FontFamilyNumeric">Bahnschrift, Segoe UI</FontFamily>

    <!-- 大写字距标签（列头角落、状态栏） -->
    <FontFamily x:Key="FontFamilyLabel">Consolas, Segoe UI</FontFamily>

    <!-- 四档字阶：正文 / 次级 / 说明 / 微标 -->
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">12.5</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11.5</sys:Double>
    <sys:Double x:Key="FontSizeMicro">10</sys:Double>

    <!-- 关键度量：改这里即全局生效，避免布局里散落魔法数 -->
    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="ToolbarHeight">34</sys:Double>
    <sys:Double x:Key="SegmentedHeight">28</sys:Double>
    <sys:Double x:Key="CellMinHeight">66</sys:Double>

    <!-- 分段控件内项圆角：轨道有 3px 内边距，内项取「轨道圆角 − 3」才是同心圆角，
         否则选中底色会在轨道两端戳出角。轨道圆角用 CardCornerRadius。 -->
    <CornerRadius x:Key="SegmentedItemCornerRadius">7</CornerRadius>

    <!-- 无边框窗口的可缩放热区（四边各 6px）。类型必须是 Thickness：
         WindowChrome.ResizeBorderThickness 不收 Double，传错会在加载期抛类型转换异常。 -->
    <Thickness x:Key="WindowResizeBorderThickness">6</Thickness>

    <Style x:Key="AppTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 噪点贴图（128×128 平铺，中性灰、随机 alpha）：明暗两套主题共用一张，
         只有强度（GrainOpacity）随主题变。不平铺缩放，避免 125% DPI 下出现摩尔纹。 -->
    <ImageBrush x:Key="GrainBrush" TileMode="Tile" Stretch="Fill"
                ViewportUnits="Absolute" Viewport="0,0,128,128"
                ImageSource="pack://application:,,,/Assets/noise.png"/>

</ResourceDictionary>
