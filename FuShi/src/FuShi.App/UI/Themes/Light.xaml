<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         明 · 晨光（M3.5 实施计划 §8.2）
         键集合必须与 Dark.xaml 完全一致，ThemeService 启动时会比对。
         颜色里的 8 位十六进制 = #AARRGGBB，alpha 已按设计稿换算好。
         ============================================================ -->

    <!-- 表面与材质 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="WindowInnerHighlightBrush" Color="#D9FFFFFF"/>

    <!-- 主窗口实色表面（M3.5 §3.7）：主窗口不是 AllowsTransparency，
         半透明背景会被 WPF 合成到黑色上（#B3FFFFFF → #B3B3B3），故单列一份不带 alpha 的实色。
         SurfaceBrush 继续留给悬浮组件那份 layered window。 -->
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F7F7F8"/>

    <!-- 1px 渐变描边：左上受光、右下背光。Border.BorderBrush 直接吃渐变 -->
    <LinearGradientBrush x:Key="WindowStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="0.34"/>
        <GradientStop Color="#12141418" Offset="1"/>
    </LinearGradientBrush>

    <!-- 顶部镜面高光带（元素自身高 132，落到底部透明） -->
    <LinearGradientBrush x:Key="SpecularBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#69FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="ShadowNearColor">#12181C26</Color>
    <Color x:Key="ShadowMidColor">#1A181C26</Color>
    <Color x:Key="ShadowFarColor">#29181C26</Color>

    <!-- 文字灰阶 -->
    <SolidColorBrush x:Key="LabelBrush" Color="#19191D"/>
    <SolidColorBrush x:Key="Label2Brush" Color="#53535A"/>
    <SolidColorBrush x:Key="Label3Brush" Color="#8A8A92"/>
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="#B4B4BC"/>

    <!-- 发丝线 -->
    <SolidColorBrush x:Key="SepBrush" Color="#1114141A"/>
    <SolidColorBrush x:Key="DividerStrongBrush" Color="#1C14141A"/>

    <!-- 强调色：明色下加深，保证白字对比度 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2FB85A"/>
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1C8C42"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#212FB85A"/>

    <!-- 主按钮渐变的两个端点颜色（GradientStop.Color 收 Color，不吃 Brush）与投影辉光 -->
    <Color x:Key="AccentColor">#2FB85A</Color>
    <Color x:Key="AccentDeepColor">#1C8C42</Color>
    <Color x:Key="AccentGlowColor">#242FB85A</Color>

    <!-- 语义色：危险 / 警告。与强调色分开，避免把「删除」染成主操作绿 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#12E05C5C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B07A1F"/>

    <!-- 交互底色 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#0B14141A"/>
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#0F14141A"/>
    <SolidColorBrush x:Key="SegmentedBackgroundBrush" Color="#0E14141A"/>
    <SolidColorBrush x:Key="SegmentedActiveBrush" Color="#FFFFFF"/>

    <!-- 当前格与当日车道 -->
    <SolidColorBrush x:Key="CurrentBackgroundBrush" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="CurrentRingBrush" Color="#6B2FB85A"/>
    <Color x:Key="CurrentGlowColor">#292FB85A</Color>
    <SolidColorBrush x:Key="TodayWashBrush" Color="#0C2FB85A"/>

    <!-- 单元格透明度：满色画刷 × 这些 alpha，切主题只改这里 -->
    <sys:Double x:Key="ChipTintOpacity">0.065</sys:Double>
    <sys:Double x:Key="ChipTintHoverOpacity">0.105</sys:Double>
    <sys:Double x:Key="ChipLineOpacity">0.05</sys:Double>
    <sys:Double x:Key="ChipLineHoverOpacity">0.10</sys:Double>
    <sys:Double x:Key="SubjectBarOpacity">0.92</sys:Double>

    <!-- 噪点与圆角 -->
    <sys:Double x:Key="GrainOpacity">0.028</sys:Double>
    <CornerRadius x:Key="WindowCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">11</CornerRadius>

</ResourceDictionary>
