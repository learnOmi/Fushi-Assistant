<Window x:Class="FuShi.UI.Dialogs.SubjectEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="{x:Static core:WindowText.SUBJECT_NEW_TITLE}"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C6C70"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 科目名 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_SUBJECT_NAME}" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4" Padding="6,4" FontSize="12.5"/>

        <!-- 颜色：固定调色板（圆点手选，无第三方取色器） -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_SUBJECT_COLOR}" Style="{StaticResource FieldLabel}"/>
        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorOptions}"
                 SelectedItem="{Binding SelectedColorOption}" Margin="0,4"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="26" Height="26" CornerRadius="13" Margin="3"
                            Background="{Binding Brush}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 分类 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_SUBJECT_CATEGORY}" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CategoryOptions}"
                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedCategory}"
                  Margin="0,4" Padding="6,4" FontSize="12.5"/>

        <!-- 错误 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                   Text="{Binding ErrorText}" Foreground="#C0392B" FontSize="11.5" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 操作条 -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static core:WindowText.BUTTON_CANCEL}" Style="{StaticResource GhostButton}" Click="OnCancel"/>
            <Button Content="{x:Static core:WindowText.BUTTON_OK}" Style="{StaticResource AccentButton}" Click="OnOk" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
