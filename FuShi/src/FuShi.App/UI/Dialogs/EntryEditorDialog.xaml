<Window x:Class="FuShi.UI.Dialogs.EntryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C6C70"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="FormField" TargetType="Control">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#12E05C5C"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表单 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 科目：下拉 + 内联新建 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_SUBJECT}" Style="{StaticResource FieldLabel}"/>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedSubject}" Style="{StaticResource FormField}"/>
                <Button Grid.Column="1" Content="{x:Static core:WindowText.NEW_SUBJECT_BUTTON}"
                        Command="{Binding NewSubjectCommand}"
                        Style="{StaticResource GhostButton}" Margin="8,4,0,4"/>
            </Grid>

            <!-- 星期 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_DAY}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DayOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedDay}" Style="{StaticResource FormField}"/>

            <!-- 开始 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_START}" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding StartHour}"
                          Width="70" Style="{StaticResource FormField}"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" Foreground="#3C3C43"/>
                <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding StartMinute}"
                          Width="70" Style="{StaticResource FormField}"/>
            </StackPanel>

            <!-- 结束 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_END}" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding EndHour}"
                          Width="70" Style="{StaticResource FormField}"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" Foreground="#3C3C43"/>
                <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding EndMinute}"
                          Width="70" Style="{StaticResource FormField}"/>
            </StackPanel>

            <!-- 备注 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_NOTE}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormField}"/>

            <!-- 启用 -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="" Style="{StaticResource FieldLabel}"/>
            <CheckBox Grid.Row="5" Grid.Column="1" Content="{x:Static core:WindowText.FIELD_ENABLED}" IsChecked="{Binding Enabled}"
                      Foreground="#3C3C43" FontSize="12.5" Margin="0,6,0,2"/>

            <!-- 跨午夜提示（非错误） -->
            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                       Text="{x:Static core:WindowText.HINT_CROSS_MIDNIGHT}"
                       Foreground="#B07A1F" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="{Binding HasCrossMidnightHint, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 校验错误 -->
            <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                       Text="{Binding ErrorText}"
                       Foreground="#C0392B" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- 底部操作条：左「删除」、右「取消 / 确定」 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{x:Static core:WindowText.BUTTON_DELETE}"
                    Style="{StaticResource DangerButton}" Click="OnDelete"
                    Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{x:Static core:WindowText.BUTTON_CANCEL}" Style="{StaticResource GhostButton}" Click="OnCancel"/>
                <Button Content="{x:Static core:WindowText.BUTTON_OK}" Style="{StaticResource AccentButton}" Click="OnOk" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
