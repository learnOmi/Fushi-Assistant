<Window x:Class="FuShi.UI.Dialogs.TaskEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="{Binding DialogTitle}"
        Icon="pack://application:,,,/Assets/fushi.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface2Brush}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- 与 EntryEditorDialog 同口径：显式 Style 必须 BasedOn 隐式模板，否则深色底/自绘箭头会丢失。 -->
        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="FormText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表单 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_TASK_TITLE}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemTitle, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormText}"/>

            <!-- 是否有截止 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_TASK_DUE}" Style="{StaticResource FieldLabel}"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Content="{x:Static core:WindowText.FIELD_TASK_NO_DUE}"
                      IsChecked="{Binding HasDue}"
                      Foreground="{DynamicResource LabelBrush}" FontSize="12.5" Margin="0,6,0,2"/>

            <!-- 截止日期 + 时刻（无截止时禁用） -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding HasDue}">
                <TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"
                         Width="112" Style="{StaticResource FormText}"/>
                <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding DueHour}"
                          Width="66" Margin="8,4,0,4" Style="{StaticResource FormCombo}"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource LabelBrush}"/>
                <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding DueMinute}"
                          Width="66" Style="{StaticResource FormCombo}"/>
            </StackPanel>

            <!-- 优先级 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_TASK_PRIORITY}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedPriority}" Style="{StaticResource FormCombo}"/>

            <!-- 重复 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:WindowText.FIELD_TASK_REPEAT}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RepeatOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedRepeat}" Style="{StaticResource FormCombo}"/>

            <!-- 校验错误 -->
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                       Text="{Binding ErrorText}"
                       Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- 底部操作条：左「删除」、右「取消 / 确定」 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{x:Static core:WindowText.BUTTON_DELETE}"
                    Style="{StaticResource DangerButton}" Click="OnDelete"
                    Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{x:Static core:WindowText.BUTTON_CANCEL}" Style="{StaticResource GhostButton}" Click="OnCancel"/>
                <Button Content="{x:Static core:WindowText.BUTTON_OK}" Style="{StaticResource AccentButton}" Click="OnOk" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
