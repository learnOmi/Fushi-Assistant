<Window x:Class="FuShi.UI.Dialogs.PhaseManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="{x:Static core:WindowText.PHASE_MANAGER_TITLE}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface2Brush}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明 -->
        <TextBlock Grid.Row="0" Text="{x:Static core:WindowText.PHASE_MANAGER_HINT}"
                   Foreground="{DynamicResource Label3Brush}" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- 阶段列表：选中项即后续「重命名 / 设为当前 / 删除」的操作对象 -->
        <ListBox Grid.Row="1" Height="190" ItemsSource="{Binding Phases}"
                 SelectedItem="{Binding SelectedPhase}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 生效标记：非生效阶段保留占位，避免行内文字左右跳动 -->
                        <Border Grid.Column="0" Width="34" Height="18" Margin="0,0,8,0"
                                CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static core:WindowText.PHASE_ACTIVE_BADGE}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   Foreground="{DynamicResource LabelBrush}"
                                   FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2" Text="{Binding StartDateText}"
                                   Foreground="{DynamicResource TextQuaternaryBrush}"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 阶段名输入 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static core:WindowText.PHASE_NAME_LABEL}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Column="1" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" FontSize="12.5"/>
        </Grid>

        <!-- 操作条 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static core:WindowText.BUTTON_CREATE}" Style="{StaticResource GhostButton}"
                    Command="{Binding CreateCommand}"/>
            <Button Content="{x:Static core:WindowText.BUTTON_RENAME}" Style="{StaticResource GhostButton}"
                    Command="{Binding RenameCommand}" Margin="8,0,0,0"/>
            <Button Content="{x:Static core:WindowText.BUTTON_ACTIVATE}" Style="{StaticResource GhostButton}"
                    Command="{Binding ActivateCommand}" Margin="8,0,0,0"/>
            <Button Content="{x:Static core:WindowText.BUTTON_DELETE}" Style="{StaticResource DangerButton}"
                    Click="OnDelete" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 错误 -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0"
                   Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                   FontSize="11.5" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 关闭 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static core:WindowText.BUTTON_CLOSE}" Style="{StaticResource AccentButton}" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
