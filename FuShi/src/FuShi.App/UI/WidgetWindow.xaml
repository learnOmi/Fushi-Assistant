<Window x:Class="FuShi.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FuShi.UI"
        Title="浮时" Width="252" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnGrab"
        MouseEnter="OnHoverEnter" MouseLeave="OnHoverLeave">
    <Border x:Name="Root" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
            BorderThickness="1" BorderBrush="#26FFFFFF" Padding="10,9,12,9">
        <StackPanel>
            <!-- 收起态：圆角卡片（非胶囊），四要素 = 科目 / 倒计时 / 进度条 / 下一节（设计文档第 6 章）
                 左侧保留团子，维持助手形象在常驻态的可见性 -->
            <Grid x:Name="Card">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <local:BotView Grid.Column="0" x:Name="Bot" Width="44" Height="44"
                               VerticalAlignment="Center" Margin="2,0,0,0" Mood="Idle"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,2,0">
                    <!-- 要素① 科目：M1 为空课表，先显示空态文案 -->
                    <TextBlock x:Name="SubjectText" Text="今天没有课" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource LabelBrush}" TextTrimming="CharacterEllipsis"/>

                    <!-- 要素② 倒计时：M1 无数据源，先折叠；M2 接入数据后显示 -->
                    <TextBlock x:Name="CountdownText" Visibility="Collapsed" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource LabelBrush}" Margin="0,3,0,0"/>

                    <!-- 要素③ 进度条：M1 无数据源，先折叠 -->
                    <Border x:Name="ProgressTrack" Visibility="Collapsed" Height="4" Margin="0,7,0,0"
                            CornerRadius="2" Background="#2EFFFFFF">
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                CornerRadius="2" Background="#D9FFFFFF"/>
                    </Border>

                    <!-- 要素④ 下一节：空课表时退化为引导文案（设计文档 5.8） -->
                    <TextBlock x:Name="NextText" Text="点击添加第一个时段" FontSize="11.5"
                               Foreground="{StaticResource Label2Brush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- 展开态：M1 为空课表态 -->
            <Border x:Name="Expanded" Visibility="Collapsed" Margin="2,10,0,2" CornerRadius="10"
                    Background="#1FFFFFFF" Padding="14,12,14,14">
                <StackPanel>
                    <TextBlock x:Name="DateText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Label2Brush}"/>
                    <TextBlock Text="今天没有课" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource LabelBrush}" Margin="0,6,0,2"/>
                    <TextBlock Text="团子陪你安心自习。课程与提醒管理将在后续版本提供。"
                               FontSize="12" Foreground="{StaticResource Label2Brush}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
