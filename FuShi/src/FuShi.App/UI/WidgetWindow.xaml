<Window x:Class="FuShi.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FuShi.UI"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="浮时" Width="252" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnGrab"
        MouseEnter="OnHoverEnter" MouseLeave="OnHoverLeave">
    <Border x:Name="Root" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1" BorderBrush="{DynamicResource DividerStrongBrush}" Padding="10,9,12,9">
        <StackPanel>
            <!-- 收起态：圆角卡片（非胶囊），四要素 = 科目 / 倒计时 / 进度条 / 下一节（设计文档第 6 章）
                 左侧保留团子，维持助手形象在常驻态的可见性。
                 全部内容经绑定取自 WidgetViewModel；M2a 为数据接入前的空态。 -->
            <Grid x:Name="Card">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <local:BotView Grid.Column="0" x:Name="Bot" Width="44" Height="44"
                               VerticalAlignment="Center" Margin="2,0,0,0" Expression="Idle"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,2,0">
                    <!-- 要素① 科目：右邻「已顺延」徽标，仅当本次被「稍后」当日顺延过才点亮（M3c）。
                         用星号列承载科目名以保留省略号裁剪，徽标列自适应宽度不挤压科目名。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SubjectText" Text="{Binding SubjectText}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource LabelBrush}" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" x:Name="ShiftBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="4"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                                Visibility="{Binding IsShifted, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="ShiftBadgeText" Text="{x:Static core:WidgetText.SHIFTED_BADGE}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentDeepBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 要素② 倒计时 -->
                    <TextBlock x:Name="CountdownText" Text="{Binding CountdownText}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource LabelBrush}" Margin="0,3,0,0"
                               Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- 要素③ 进度条：两列星号布局，填充列宽度 = 进度百分比 -->
                    <Border x:Name="ProgressTrack" Height="4" Margin="0,7,0,0"
                            CornerRadius="2" Background="{DynamicResource DividerStrongBrush}"
                            Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToStar}}"/>
                                <ColumnDefinition Width="{Binding ProgressRemainderPercent, Converter={StaticResource PercentToStar}}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource LabelBrush}"/>
                        </Grid>
                    </Border>

                    <!-- 要素④ 下一节：空课表时退化为引导文案（设计文档 5.8） -->
                    <TextBlock x:Name="NextText" Text="{Binding NextText}" FontSize="11.5"
                               Foreground="{DynamicResource Label2Brush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- 展开态：内容同样经绑定；M2a 为空课表态 -->
            <Border x:Name="Expanded" Margin="2,10,0,2" CornerRadius="10"
                    Background="{DynamicResource Surface2Brush}" Padding="14,12,14,14"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="DateText" Text="{Binding DateText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Label2Brush}"/>
                    <TextBlock x:Name="ExpandedTitle" Text="{Binding ExpandedTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource LabelBrush}" Margin="0,6,0,2"/>
                    <TextBlock x:Name="ExpandedBody" Text="{Binding ExpandedBody}"
                               FontSize="12" Foreground="{DynamicResource Label2Brush}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0"/>

                    <!-- 展开态「打开课表」：唤起主窗口（设计 5.3 / 第 6 章） -->
                    <Button x:Name="OpenScheduleButton" Content="打开课表"
                            Click="OnOpenSchedule" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Padding="12,6" Cursor="Hand"
                            Foreground="{DynamicResource AccentInkBrush}" BorderThickness="0"
                            Background="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
