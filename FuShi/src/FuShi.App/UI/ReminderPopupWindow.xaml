<Window x:Class="FuShi.UI.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FuShi.Core"
        Title="浮时 · 提醒"
        Width="{x:Static core:NotificationConstants.POPUP_WIDTH}" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonUp="OnPopupClick">
    <Window.Resources>
        <!-- 动作按钮：三枚等宽，弱底 + 强调描边，扫描成本低 -->
        <Style x:Key="PopupActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="#1FFFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作按钮（开始）：强调色填充，视觉首位 -->
        <Style x:Key="PopupPrimaryButton" TargetType="Button" BasedOn="{StaticResource PopupActionButton}">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 自绘弹窗（ADR-4 主通道）：左侧强调色边条 + 标题 + 正文 +（M3b）动作按钮。
         文案由构造参数注入；按钮仅在「有归属实例」时出现，汇总类通知退化为哑壳。 -->
    <Border CornerRadius="12" Background="{StaticResource Surface2Brush}"
            BorderThickness="1" BorderBrush="#26FFFFFF" Padding="16,14,16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{StaticResource LabelBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{StaticResource Label2Brush}"
                           Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"/>

                <!-- 动作区：内容在代码后置里按「是否有归属实例」决定显隐与文案 -->
                <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                    <Button x:Name="StartButton" Content="{x:Static core:ReminderText.ACTION_START}"
                            Style="{StaticResource PopupPrimaryButton}" Click="OnStart"/>
                    <Button x:Name="SnoozeButton" Style="{StaticResource PopupActionButton}" Click="OnSnooze"/>
                    <Button x:Name="SkipButton" Content="{x:Static core:ReminderText.ACTION_SKIP}"
                            Style="{StaticResource PopupActionButton}" Click="OnSkip"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
