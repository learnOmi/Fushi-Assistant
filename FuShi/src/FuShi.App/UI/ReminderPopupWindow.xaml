<Window x:Class="FuShi.UI.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浮时 · 提醒"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonUp="OnPopupClick">
    <!-- 自绘弹窗（ADR-4 主通道）：左侧强调色边条 + 标题 + 正文。
         仅骨架：文案与边条颜色由构造参数注入，自动消失时长见 NotificationConstants。 -->
    <Border CornerRadius="12" Background="{StaticResource Surface2Brush}"
            BorderThickness="1" BorderBrush="#26FFFFFF" Padding="16,14,16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{StaticResource LabelBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{StaticResource Label2Brush}"
                           Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
