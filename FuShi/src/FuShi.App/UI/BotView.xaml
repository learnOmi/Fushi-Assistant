<UserControl x:Class="FuShi.UI.BotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        团 · 黑团子（设计稿：浮时-助手定稿-黑团子.html）
        坐标系固定 120×120，所有形变数值与设计稿一一对应，不做换算。
        脸上永远只有两只眼：竖椭圆与六种替代形状，无嘴无眉无腮红。
    -->
    <UserControl.Resources>
        <!-- 光色画刷：代码里做 180ms 颜色动画，必须保持未冻结，故不做 Freeze -->
        <SolidColorBrush x:Key="EyeBrush" Color="#CFE9FF"/>

        <!-- 壳体几何：92×48、圆角 24 = 横向鹅卵石；同时用作高光层的裁剪路径 -->
        <PathGeometry x:Key="BodyGeometry"
                      Figures="M38,38 H82 A24,24 0 0 1 82,86 H38 A24,24 0 0 1 38,38 Z"/>

        <!-- 壳体亮面：左上角高光，向右下压深到近黑 -->
        <RadialGradientBrush x:Key="BodyFill"
                             GradientOrigin="0.36,0.2" Center="0.36,0.2"
                             RadiusX="0.54" RadiusY="1.04">
            <GradientStop Color="#4E565E" Offset="0"/>
            <GradientStop Color="#262B31" Offset="0.40"/>
            <GradientStop Color="#12151A" Offset="0.76"/>
            <GradientStop Color="#0B0D11" Offset="1"/>
        </RadialGradientBrush>

        <!-- 替代形状的发光：颜色随光色动画（代码中按 GlowTone 更新） -->
        <DropShadowEffect x:Key="ShapeGlow" Color="#CFE9FF"
                          BlurRadius="5" ShadowDepth="0" Opacity="1"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="120" Height="120" Background="Transparent">

            <!-- 地面投影：让团子"落"在卡片上，而不是浮在空气里 -->
            <Ellipse Canvas.Left="30" Canvas.Top="88" Width="60" Height="10" Fill="#4D000000">
                <Ellipse.Effect>
                    <BlurEffect Radius="5"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 壳体：亮面鹅卵石 -->
            <Path x:Name="Body" Data="{StaticResource BodyGeometry}"
                  Fill="{StaticResource BodyFill}"
                  Stroke="#24FFFFFF" StrokeThickness="1"/>

            <!-- 壳内高光层：裁剪到壳体几何，避免高光溢出圆角 -->
            <Canvas Width="120" Height="120" Clip="{StaticResource BodyGeometry}">
                <!-- 顶部大高光 -->
                <Ellipse Canvas.Left="16" Canvas.Top="34" Width="68" Height="22"
                         Fill="#21FFFFFF" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-5"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <BlurEffect Radius="4"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 左上小高光：釉面质感的关键一笔 -->
                <Ellipse Canvas.Left="23" Canvas.Top="40.4" Width="22" Height="7.2"
                         Fill="#38FFFFFF" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-16"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <BlurEffect Radius="1"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 底部冷色反光 -->
                <Ellipse Canvas.Left="30" Canvas.Top="78" Width="60" Height="16" Fill="#1A6E96D2">
                    <Ellipse.Effect>
                        <BlurEffect Radius="4"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 底部压深：让壳体下沿"沉"下去 -->
                <Ellipse Canvas.Left="22" Canvas.Top="82" Width="76" Height="16" Fill="#59000000">
                    <Ellipse.Effect>
                        <BlurEffect Radius="4"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- 面部层 -->
            <Canvas Width="120" Height="120">
                <!--
                    每只眼都是一个独立 120 画布，形变作用在整层上：
                    TransformGroup 顺序 = Translate → Scale → Rotate，
                    与 CSS「rotate scale translate」的右到左应用顺序等价。
                -->
                <Canvas x:Name="EyeGroupL" Width="120" Height="120">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeMoveL"/>
                            <ScaleTransform x:Name="EyeScaleL" CenterX="44.5" CenterY="60"/>
                            <RotateTransform x:Name="EyeRotateL" CenterX="44.5" CenterY="60"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- 光晕：模糊椭圆垫在眼后面，光色来自画刷 -->
                    <Ellipse Canvas.Left="34" Canvas.Top="45" Width="21" Height="30"
                             Fill="{StaticResource EyeBrush}" Opacity="0.30">
                        <Ellipse.Effect>
                            <BlurEffect Radius="5"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 竖椭圆眼 -->
                    <Ellipse x:Name="EyeOvalL" Canvas.Left="37.1" Canvas.Top="47"
                             Width="14.8" Height="26" Fill="{StaticResource EyeBrush}"/>

                    <!-- 眼内暗部：让屏幕有纵深 -->
                    <Ellipse Canvas.Left="39.3" Canvas.Top="56.9" Width="10.4" Height="15.2" Fill="#2E060E1E">
                        <Ellipse.Effect>
                            <BlurEffect Radius="2"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 眼内高光点 -->
                    <Ellipse Canvas.Left="41.1" Canvas.Top="49.1" Width="6.8" Height="8.8"
                             Fill="#80FFFFFF">
                        <Ellipse.Effect>
                            <BlurEffect Radius="1"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Canvas x:Name="EyeGroupR" Width="120" Height="120">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeMoveR"/>
                            <ScaleTransform x:Name="EyeScaleR" CenterX="75.5" CenterY="60"/>
                            <RotateTransform x:Name="EyeRotateR" CenterX="75.5" CenterY="60"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="65" Canvas.Top="45" Width="21" Height="30"
                             Fill="{StaticResource EyeBrush}" Opacity="0.30">
                        <Ellipse.Effect>
                            <BlurEffect Radius="5"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse x:Name="EyeOvalR" Canvas.Left="68.1" Canvas.Top="47"
                             Width="14.8" Height="26" Fill="{StaticResource EyeBrush}"/>

                    <Ellipse Canvas.Left="70.3" Canvas.Top="56.9" Width="10.4" Height="15.2" Fill="#2E060E1E">
                        <Ellipse.Effect>
                            <BlurEffect Radius="2"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Canvas.Left="72.1" Canvas.Top="49.1" Width="6.8" Height="8.8"
                             Fill="#80FFFFFF">
                        <Ellipse.Effect>
                            <BlurEffect Radius="1"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- 替代眼形：同一时刻只显示一组，整体带 5px 发光 -->
                <Canvas x:Name="ShapeLayer" Width="120" Height="120"
                        Effect="{StaticResource ShapeGlow}">

                    <!-- happy / done：上弧 -->
                    <Canvas x:Name="Arcs" Visibility="Collapsed">
                        <Path Data="M37.5,64 Q44.5,54 51.5,64" Stroke="{StaticResource EyeBrush}"
                              StrokeThickness="4.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M68.5,64 Q75.5,54 82.5,64" Stroke="{StaticResource EyeBrush}"
                              StrokeThickness="4.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- laugh：更弯更挤的深弧 -->
                    <Canvas x:Name="ArcsDeep" Visibility="Collapsed">
                        <Path Data="M36.5,63.5 Q44.5,50.5 52.5,63.5" Stroke="{StaticResource EyeBrush}"
                              StrokeThickness="5.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M67.5,63.5 Q75.5,50.5 83.5,63.5" Stroke="{StaticResource EyeBrush}"
                              StrokeThickness="5.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- surprise：瞬间圆睁 -->
                    <Canvas x:Name="Sur" Visibility="Collapsed">
                        <Ellipse Canvas.Left="35.7" Canvas.Top="51.2" Width="17.6" Height="17.6"
                                 Fill="{StaticResource EyeBrush}"/>
                        <Ellipse Canvas.Left="66.7" Canvas.Top="51.2" Width="17.6" Height="17.6"
                                 Fill="{StaticResource EyeBrush}"/>
                    </Canvas>

                    <!-- dizzy：两枚 X -->
                    <Canvas x:Name="Cross" Visibility="Collapsed">
                        <Path Data="M38.9,53.6 L50.1,66.4 M50.1,53.6 L38.9,66.4"
                              Stroke="{StaticResource EyeBrush}" StrokeThickness="3.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M69.9,53.6 L81.1,66.4 M81.1,53.6 L69.9,66.4"
                              Stroke="{StaticResource EyeBrush}" StrokeThickness="3.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- late：屏上打出「!」 -->
                    <Canvas x:Name="Excl" Visibility="Collapsed">
                        <Rectangle Canvas.Left="41.8" Canvas.Top="50.5" Width="5.4" Height="10.8"
                                   RadiusX="2.7" RadiusY="2.7" Fill="{StaticResource EyeBrush}"/>
                        <Ellipse Canvas.Left="41.7" Canvas.Top="63.2" Width="5.6" Height="5.6"
                                 Fill="{StaticResource EyeBrush}"/>
                        <Rectangle Canvas.Left="72.8" Canvas.Top="50.5" Width="5.4" Height="10.8"
                                   RadiusX="2.7" RadiusY="2.7" Fill="{StaticResource EyeBrush}"/>
                        <Ellipse Canvas.Left="72.7" Canvas.Top="63.2" Width="5.6" Height="5.6"
                                 Fill="{StaticResource EyeBrush}"/>
                    </Canvas>

                    <!-- love：屏变心形（唯一玫瑰光） -->
                    <Canvas x:Name="Hearts" Visibility="Collapsed">
                        <Path Fill="{StaticResource EyeBrush}"
                              Data="M44.5,66.2 C40.9,62.6 37.3,59.4 37.3,55.8 C37.3,52.8 39.6,51 41.9,51
                                    C43.3,51 44.2,51.9 44.5,52.8 C44.8,51.9 45.7,51 47.1,51
                                    C49.4,51 51.7,52.8 51.7,55.8 C51.7,59.4 48.1,62.6 44.5,66.2 Z"/>
                        <Path Fill="{StaticResource EyeBrush}"
                              Data="M75.5,66.2 C71.9,62.6 68.3,59.4 68.3,55.8 C68.3,52.8 70.6,51 72.9,51
                                    C74.3,51 75.2,51.9 75.5,52.8 C75.8,51.9 76.7,51 78.1,51
                                    C80.4,51 82.7,52.8 82.7,55.8 C82.7,59.4 79.1,62.6 75.5,66.2 Z"/>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
