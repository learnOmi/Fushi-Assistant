<UserControl x:Class="FuShi.UI.BotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EyeBrush" Color="#CFE9FF"/>
        <DropShadowEffect x:Key="EyeGlow" Color="#CFE9FF" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
        <DropShadowEffect x:Key="BodyShadow" Color="#000000" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64" Background="Transparent">

            <!-- 状态光晕：很淡的一圈，颜色随情绪（代码中按 Mood 重建） -->
            <Ellipse x:Name="Aura" Width="60" Height="56" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,3,0,0" Opacity="0.85"/>

            <!-- 壳体：微扁圆润的近黑团子（非正圆，底部略沉） -->
            <Ellipse x:Name="Body" Width="54" Height="50" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,3,0,0" Effect="{StaticResource BodyShadow}">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.36,0.18" Center="0.42,0.24" RadiusX="0.85" RadiusY="0.9">
                        <GradientStop Color="#34343E" Offset="0"/>
                        <GradientStop Color="#1A1A20" Offset="0.52"/>
                        <GradientStop Color="#0A0A0F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 顶部釉面高光：让黑壳"亮面"而非塑料 -->
            <Ellipse Width="54" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.62">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 面部层：眨眼（缩放）与张望（平移）都作用在这层 -->
            <Canvas x:Name="Face" Width="64" Height="64" RenderTransformOrigin="0.5,0.485">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BlinkScale"/>
                        <TranslateTransform x:Name="GlanceTx"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- 竖椭圆发光眼 -->
                <Ellipse x:Name="EyeL" Canvas.Left="21.2" Canvas.Top="25.4" Width="6.8" Height="11.2"
                         Fill="{StaticResource EyeBrush}" Effect="{StaticResource EyeGlow}"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="EyeScaleL"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeR" Canvas.Left="36.0" Canvas.Top="25.4" Width="6.8" Height="11.2"
                         Fill="{StaticResource EyeBrush}" Effect="{StaticResource EyeGlow}"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="EyeScaleR"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- 开心眯眼弧（done 态替换竖椭圆） -->
                <Path x:Name="ArcL" Canvas.Left="21.2" Canvas.Top="27.2" Visibility="Collapsed"
                      Stroke="{StaticResource EyeBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Effect="{StaticResource EyeGlow}"
                      Data="M 0,4.6 A 3.2,3.2 0 0 1 6.8,4.6"/>
                <Path x:Name="ArcR" Canvas.Left="36.0" Canvas.Top="27.2" Visibility="Collapsed"
                      Stroke="{StaticResource EyeBrush}" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Effect="{StaticResource EyeGlow}"
                      Data="M 0,4.6 A 3.2,3.2 0 0 1 6.8,4.6"/>
            </Canvas>

        </Grid>
    </Viewbox>
</UserControl>
