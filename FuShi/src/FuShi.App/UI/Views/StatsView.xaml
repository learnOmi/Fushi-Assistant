<UserControl x:Class="FuShi.UI.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 区间切换：胶囊单选，选中态复用分段控件的底色令牌，与页签同一套语言 -->
        <Style x:Key="RangeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource SegmentedItemCornerRadius}"
                                Padding="14,5" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Label2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentedActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片内文字层级：标签 / 读数 / 副标题 -->
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
            <!-- 区间工具条：左切换、右区间文案 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="StatsRange"
                                 Content="{x:Static core:WindowText.STATS_RANGE_THIS_WEEK}"
                                 Style="{StaticResource RangeChip}"
                                 IsChecked="{Binding IsThisWeek, Mode=TwoWay}"/>
                    <RadioButton GroupName="StatsRange"
                                 Content="{x:Static core:WindowText.STATS_RANGE_THIS_MONTH}"
                                 Style="{StaticResource RangeChip}"
                                 IsChecked="{Binding IsThisMonth, Mode=TwoWay}"/>
                    <RadioButton GroupName="StatsRange"
                                 Content="{x:Static core:WindowText.STATS_RANGE_CUSTOM}"
                                 Style="{StaticResource RangeChip}"
                                 IsChecked="{Binding IsCustom, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding RangeText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource Label3Brush}"
                           FontFamily="{StaticResource FontFamilyNumeric}" FontSize="{StaticResource FontSizeCaption}"/>
            </Grid>

            <!-- 自定义区间：格式错误与起止颠倒都就地提示，不弹对话框 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                <TextBox Width="120" Text="{Binding CustomFromText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static core:WindowText.STATS_DATE_FORMAT}"/>
                <TextBlock Text="{x:Static core:WindowText.STATS_FROM_TO_SEPARATOR}" VerticalAlignment="Center"
                           Margin="8,0" Foreground="{DynamicResource Label3Brush}"/>
                <TextBox Width="120" Text="{Binding CustomToText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static core:WindowText.STATS_DATE_FORMAT}"/>
                <Button Content="{x:Static core:WindowText.STATS_APPLY_RANGE}"
                        Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                        Command="{Binding ApplyCustomRangeCommand}"/>
            </StackPanel>

            <!-- 错误提示：自定义校验与加载失败共用一行 -->
            <TextBlock Text="{Binding ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontSizeCaption}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 空态：没有记录时不画 0 值图表 -->
            <StackPanel HorizontalAlignment="Center" Margin="0,72,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static core:WindowText.STATS_EMPTY}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Label2Brush}" FontSize="{StaticResource FontSizeTitle}"/>
                <TextBlock Text="{x:Static core:WindowText.STATS_EMPTY_HINT}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" Foreground="{DynamicResource Label3Brush}"
                           FontSize="{StaticResource FontSizeCaption}"/>
            </StackPanel>

            <!-- 数据区 -->
            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <!-- 三张数字卡 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="18,14"
                            Background="{DynamicResource Surface2Brush}"
                            CornerRadius="{DynamicResource CardCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:WindowText.STATS_CARD_RATE}" Style="{StaticResource CardCaption}"/>
                            <TextBlock Text="{Binding CompletionRateText}" Style="{StaticResource CardValue}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding RateSubtitleText}" Style="{StaticResource CardSubtitle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="3,0,3,0" Padding="18,14"
                            Background="{DynamicResource Surface2Brush}"
                            CornerRadius="{DynamicResource CardCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:WindowText.STATS_CARD_ACTUAL}" Style="{StaticResource CardCaption}"/>
                            <TextBlock Text="{Binding ActualHoursText}" Style="{StaticResource CardValue}"/>
                            <TextBlock Text="{Binding PlannedSubtitleText}" Style="{StaticResource CardSubtitle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="18,14"
                            Background="{DynamicResource Surface2Brush}"
                            CornerRadius="{DynamicResource CardCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:WindowText.STATS_CARD_DONE}" Style="{StaticResource CardCaption}"/>
                            <TextBlock Text="{Binding DoneCountText}" Style="{StaticResource CardValue}"/>
                            <TextBlock Text="{Binding DoneSubtitleText}" Style="{StaticResource CardSubtitle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 科目分布：原生横条，不引图表库 -->
                <Border Margin="0,12,0,0" Padding="20,16"
                        Background="{DynamicResource Surface2Brush}"
                        CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="{x:Static core:WindowText.STATS_TITLE_SUBJECTS}" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding SubjectRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Ellipse Grid.RowSpan="2" Width="8" Height="8" Margin="0,4,10,0"
                                                 VerticalAlignment="Top" Fill="{Binding Brush}"/>

                                        <Grid Grid.Column="1" Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Label2Brush}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DetailText}"
                                                       Foreground="{DynamicResource Label3Brush}"
                                                       FontFamily="{StaticResource FontFamilyNumeric}"
                                                       FontSize="{StaticResource FontSizeCaption}"/>
                                        </Grid>

                                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,6,0,0"
                                              Height="{x:Static core:UiConstants.STATS_SUBJECT_BAR_HEIGHT}">
                                            <Border Background="{DynamicResource SepBrush}" CornerRadius="3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding SharePercent, Converter={StaticResource PercentToStar}}"/>
                                                    <ColumnDefinition Width="{Binding RemainPercent, Converter={StaticResource PercentToStar}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding Brush}" CornerRadius="3"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 最近 7 天：日期固定 7 格，无记录的日子显示占位 -->
                <Border Margin="0,12,0,0" Padding="20,16"
                        Background="{DynamicResource Surface2Brush}"
                        CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="{x:Static core:WindowText.STATS_TITLE_RECENT}" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding DayRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Label3Brush}"
                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                   FontSize="{StaticResource FontSizeMicro}"/>

                                        <Grid Height="{x:Static core:UiConstants.STATS_DAY_CHART_HEIGHT}" Margin="0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="{Binding RemainPercent, Converter={StaticResource PercentToStar}}"/>
                                                <RowDefinition Height="{Binding BarPercent, Converter={StaticResource PercentToStar}}"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.RowSpan="2" Margin="9,0" CornerRadius="3"
                                                    Background="{DynamicResource SegmentedBackgroundBrush}"/>
                                            <Border Grid.Row="1" Margin="9,0" CornerRadius="3"
                                                    Background="{DynamicResource AccentBrush}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding LabelText}" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
                                                    <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
