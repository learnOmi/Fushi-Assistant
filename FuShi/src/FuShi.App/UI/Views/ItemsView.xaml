<UserControl x:Class="FuShi.UI.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             xmlns:conv="clr-namespace:FuShi.UI.Converters"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 局部声明：避免依赖宿主窗口 Window.Resources 的查找顺序（UserControl 单独加载时也能解析）。 -->
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="ItemsGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="ItemsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <!-- 已完成 / 已跳过的行降低存在感（仍是可编辑状态，故不隐藏） -->
                <DataTrigger Binding="{Binding IsPending}" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemsGhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="ItemsAccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头：待办计数 + 新增 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PendingCountText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Label2Brush}" FontSize="13"/>
            <Button Grid.Column="1" Content="{x:Static core:WindowText.ITEMS_ADD}"
                    Command="{Binding AddItemCommand}"
                    Style="{StaticResource ItemsAccentButton}"/>
        </Grid>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Header}" Style="{StaticResource ItemsGroupHeader}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemsCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 左：标题 + 元信息 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                                               Foreground="{DynamicResource LabelBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Width="6" Height="6" CornerRadius="3"
                                                                VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Label3Brush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="{Binding PriorityLabel}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Label3Brush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="·" FontSize="11.5" Margin="5,0"
                                                                   Foreground="{DynamicResource Label3Brush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DueText}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Label3Brush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="·" FontSize="11.5" Margin="5,0"
                                                                   Foreground="{DynamicResource Label3Brush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Label3Brush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 右：操作 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{x:Static core:WindowText.ITEMS_ACTION_DONE}"
                                                            Style="{StaticResource ItemsAccentButton}"
                                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Content="{x:Static core:WindowText.ITEMS_ACTION_SKIP}"
                                                            Style="{StaticResource ItemsGhostButton}"
                                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.MarkSkipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Content="{x:Static core:WindowText.ITEMS_ACTION_EDIT}"
                                                            Style="{StaticResource ItemsGhostButton}"
                                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空态 / 错误 -->
        <TextBlock Grid.Row="1" Text="{x:Static core:WindowText.ITEMS_EMPTY_HINT}"
                   Foreground="{DynamicResource Label3Brush}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Grid.Row="1" Text="{Binding ErrorText}"
                   Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
