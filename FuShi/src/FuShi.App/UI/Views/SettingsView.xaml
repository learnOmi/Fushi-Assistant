<UserControl x:Class="FuShi.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             xmlns:domain="clr-namespace:FuShi.Domain;assembly=FuShi.Domain"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 表单样式沿用编辑对话框：字段标签与控件同源，明暗共用一套令牌 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <!-- 下拉框沿用 Controls.xaml 的隐式模板（深色底 + 自绘箭头）。
             注意：显式 Style 会顶掉隐式样式，所以这里必须 BasedOn 隐式样式，
             只补外层间距；不要再写 Padding，否则会挤掉右侧箭头留白。 -->
        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Label3Brush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- 卡片用 Surface2 材质，控件统一走 Controls.xaml 的主题化模板。
         DataContext 由宿主显式绑定到 SettingsViewModel（吸取缺陷 2 教训，不依赖继承）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="22,20"
                HorizontalAlignment="Left" MinWidth="560">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- M5a 数据与诊断：标题 / 路径信息 / 操作按钮 / 成功提示 / 失败提示 / 保存 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 不透明度：滑块实时预览 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_OPACITY}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                    <Slider Minimum="{x:Static domain:ModelDefaults.MIN_OPACITY}"
                            Maximum="{x:Static domain:ModelDefaults.MAX_OPACITY}"
                            Value="{Binding Opacity}" Width="260" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OpacityText}" Margin="10,0,0,0"
                               Foreground="{DynamicResource LabelBrush}" FontSize="12.5" VerticalAlignment="Center" Width="46"/>
                </StackPanel>

                <!-- 免打扰 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_QUIET_TITLE}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="" Style="{StaticResource FieldLabel}"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="{x:Static core:WindowText.SETTINGS_QUIET_ENABLED}"
                          IsChecked="{Binding QuietEnabled}" Foreground="{DynamicResource LabelBrush}" FontSize="12.5" Margin="0,4,0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_QUIET_START}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding QuietEnabled}">
                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietStartHour}" Width="70" Style="{StaticResource FormCombo}"/>
                    <TextBlock Text="{x:Static core:WindowText.TIME_SEPARATOR}" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource LabelBrush}"/>
                    <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding QuietStartMinute}" Width="70" Style="{StaticResource FormCombo}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_QUIET_END}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding QuietEnabled}">
                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietEndHour}" Width="70" Style="{StaticResource FormCombo}"/>
                    <TextBlock Text="{x:Static core:WindowText.TIME_SEPARATOR}" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource LabelBrush}"/>
                    <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding QuietEndMinute}" Width="70" Style="{StaticResource FormCombo}"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_QUIET_HINT}" Style="{StaticResource HintText}"/>

                <!-- 提前提醒 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_LEAD_TITLE}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding LeadOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLeadOption}" Width="130" HorizontalAlignment="Left" Style="{StaticResource FormCombo}"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_LEAD_HINT}" Style="{StaticResource HintText}"/>

                <!-- 时区 -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_TIMEZONE}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding TimezoneOptions}"
                          SelectedItem="{Binding SelectedTimezone}" Width="260" HorizontalAlignment="Left" Style="{StaticResource FormCombo}"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_TIMEZONE_HINT}" Style="{StaticResource HintText}"/>

                <!-- 主题 -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_THEME}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedTheme}" Width="130" HorizontalAlignment="Left" Style="{StaticResource FormCombo}"/>
                <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_THEME_HINT}" Style="{StaticResource HintText}"/>

                <!-- 开机自启（写入 HKCU Run；失败时回滚并就地提示原因） -->
                <TextBlock Grid.Row="12" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_AUTOSTART}" Style="{StaticResource FieldLabel}"/>
                <CheckBox Grid.Row="12" Grid.Column="1" Content="{x:Static core:WindowText.SETTINGS_AUTOSTART_ENABLED}"
                          IsChecked="{Binding Autostart}" Foreground="{DynamicResource LabelBrush}" FontSize="12.5" Margin="0,4,0,2"/>
                <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_AUTOSTART_HINT}" Style="{StaticResource HintText}"/>

                <!-- 数据与诊断（M5a）：路径只读展示 + 打开目录 / 立即备份 / 导出 CSV -->
                <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_DATA_TITLE}" Style="{StaticResource SectionTitle}"/>
                <StackPanel Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <TextBlock Text="{x:Static core:WindowText.SETTINGS_DATA_HINT}" Style="{StaticResource HintText}"/>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="{x:Static core:WindowText.SETTINGS_DATABASE_PATH}"/><Run Text="  "/><Run Text="{Binding DatabasePathText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="{x:Static core:WindowText.SETTINGS_BACKUP_DIRECTORY}"/><Run Text="  "/><Run Text="{Binding BackupDirectoryText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="{x:Static core:WindowText.SETTINGS_LAST_BACKUP}"/><Run Text="  "/><Run Text="{Binding LastBackupText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="{x:Static core:WindowText.SETTINGS_LOG_DIRECTORY}"/><Run Text="  "/><Run Text="{Binding LogDirectoryText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="{x:Static core:WindowText.SETTINGS_VERSION}"/><Run Text="  "/><Run Text="{Binding VersionText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,4">
                    <Button Content="{x:Static core:WindowText.SETTINGS_OPEN_DATA_DIRECTORY}" Command="{Binding OpenDataDirectoryCommand}" Margin="0,0,8,0"/>
                    <Button Content="{x:Static core:WindowText.SETTINGS_BACKUP_NOW}" Command="{Binding BackupNowCommand}" Margin="0,0,8,0"/>
                    <Button Content="{x:Static core:WindowText.SETTINGS_EXPORT_CSV}" Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
                <TextBlock Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AccentDeepBrush}" FontSize="11.5" TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusError}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                           Visibility="{Binding HasStatusError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 保存 -->
                <StackPanel Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{x:Static core:WindowText.SETTINGS_SAVE}"
                            Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
                    <TextBlock Text="{x:Static core:WindowText.SETTINGS_SAVED}"
                               Foreground="{DynamicResource AccentDeepBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
