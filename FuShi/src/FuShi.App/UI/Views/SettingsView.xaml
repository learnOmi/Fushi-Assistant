<UserControl x:Class="FuShi.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             xmlns:domain="clr-namespace:FuShi.Domain;assembly=FuShi.Domain"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 表单样式沿用编辑对话框（偏差 3）：浅底密集表单更易读 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C6C70"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="FormField" TargetType="Control">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- 浅色卡片嵌在暗色主窗口里：与编辑对话框观感一致，控件可继续用系统浅色默认样式。
         DataContext 由宿主显式绑定到 SettingsViewModel（吸取缺陷 2 教训，不依赖继承）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <Border Background="#F5F5F7" CornerRadius="10" Padding="22,20"
                HorizontalAlignment="Left" MinWidth="560">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 不透明度：滑块实时预览 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_OPACITY}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                    <Slider Minimum="{x:Static domain:ModelDefaults.MIN_OPACITY}"
                            Maximum="{x:Static domain:ModelDefaults.MAX_OPACITY}"
                            Value="{Binding Opacity}" Width="260" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OpacityText}" Margin="10,0,0,0"
                               Foreground="#3C3C43" FontSize="12.5" VerticalAlignment="Center" Width="46"/>
                </StackPanel>

                <!-- 免打扰 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_QUIET_TITLE}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="" Style="{StaticResource FieldLabel}"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="{x:Static core:WindowText.SETTINGS_QUIET_ENABLED}"
                          IsChecked="{Binding QuietEnabled}" Foreground="#3C3C43" FontSize="12.5" Margin="0,4,0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_QUIET_START}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding QuietEnabled}">
                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietStartHour}" Width="70" Style="{StaticResource FormField}"/>
                    <TextBlock Text="{x:Static core:WindowText.TIME_SEPARATOR}" VerticalAlignment="Center" Margin="6,0" Foreground="#3C3C43"/>
                    <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding QuietStartMinute}" Width="70" Style="{StaticResource FormField}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_QUIET_END}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding QuietEnabled}">
                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietEndHour}" Width="70" Style="{StaticResource FormField}"/>
                    <TextBlock Text="{x:Static core:WindowText.TIME_SEPARATOR}" VerticalAlignment="Center" Margin="6,0" Foreground="#3C3C43"/>
                    <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding QuietEndMinute}" Width="70" Style="{StaticResource FormField}"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_QUIET_HINT}" Style="{StaticResource HintText}"/>

                <!-- 提前提醒 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_LEAD_TITLE}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding LeadOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLeadOption}" Width="130" HorizontalAlignment="Left" Style="{StaticResource FormField}"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_LEAD_HINT}" Style="{StaticResource HintText}"/>

                <!-- 时区 -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_TIMEZONE}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding TimezoneOptions}"
                          SelectedItem="{Binding SelectedTimezone}" Width="260" HorizontalAlignment="Left" Style="{StaticResource FormField}"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_TIMEZONE_HINT}" Style="{StaticResource HintText}"/>

                <!-- 主题 -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="{x:Static core:WindowText.SETTINGS_THEME}" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedTheme}" Width="130" HorizontalAlignment="Left" Style="{StaticResource FormField}"/>
                <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static core:WindowText.SETTINGS_THEME_HINT}" Style="{StaticResource HintText}"/>

                <!-- 保存 -->
                <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{x:Static core:WindowText.SETTINGS_SAVE}"
                            Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
                    <TextBlock Text="{x:Static core:WindowText.SETTINGS_SAVED}"
                               Foreground="#2E7D32" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
