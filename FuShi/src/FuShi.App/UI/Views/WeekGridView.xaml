<UserControl x:Class="FuShi.UI.Views.WeekGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 表头：时刻列（固定宽）+ 周一…周日（等分）。
                 时间列用「固定宽度」而非共享尺寸组，表头与数据行取同一常量即可对齐。 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static core:WindowText.TIME_COLUMN_HEADER}" Width="{x:Static core:UiConstants.GRID_TIME_COLUMN_WIDTH}"
                           Foreground="{DynamicResource Label3Brush}" FontSize="11.5" VerticalAlignment="Center"/>
                <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding DayHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Label2Brush}" FontSize="12" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 数据行：一行 = 一个起始时刻 -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                       Width="{x:Static core:UiConstants.GRID_TIME_COLUMN_WIDTH}"
                                       Foreground="{DynamicResource Label2Brush}" FontSize="12"
                                       VerticalAlignment="Center"/>

                            <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 单元格：空格子也可点击（以该天该时刻预填新建） -->
                                        <Button Command="{Binding ClickCommand}" Cursor="Hand"
                                                MinHeight="{x:Static core:UiConstants.GRID_CELL_MIN_HEIGHT}"
                                                Margin="2,0"
                                                Opacity="{Binding CellOpacity}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="Bd"
                                                                CornerRadius="{x:Static core:UiConstants.GRID_CELL_CORNER_RADIUS}"
                                                                Background="{Binding SubjectBrush}"
                                                                BorderThickness="1" BorderBrush="#26FFFFFF">
                                                            <ContentPresenter Margin="8,6" VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <Border x:Name="CurrentRing" CornerRadius="{x:Static core:UiConstants.GRID_CELL_CORNER_RADIUS}"
                                                                BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                                                Background="Transparent" IsHitTestVisible="False"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SubjectName}"
                                                           Foreground="{DynamicResource LabelBrush}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeRangeText}"
                                                           Foreground="#CCFFFFFF" FontSize="10.5" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="#B3FFFFFF" FontSize="9.5" Margin="0,2,0,0"
                                                           Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
