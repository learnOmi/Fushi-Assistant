<UserControl x:Class="FuShi.UI.Views.WeekGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FuShi.Core"
             FontFamily="{StaticResource AppFont}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <!-- 单元格按钮：模板全部自定义，外观由模板内多层 Border 拼出。
             四层顺序 = 染色层 → 当前浅底 → 发丝描边 → 左色条 → 内容 → 当前环。
             空格子不画任何一层，只在悬停时浮出淡底与「+」。 -->
        <Style x:Key="WeekCellButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="{StaticResource CellMinHeight}"/>
            <Setter Property="Opacity" Value="{Binding CellOpacity}"/>
            <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <!-- 1 染色层：满色科目刷 × 主题令牌给的 alpha。
                                 只在主题切换时改 alpha，42 个格子零刷新。 -->
                            <Border x:Name="Tint" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{Binding SubjectBrush}" Opacity="0" Visibility="Collapsed"/>

                            <!-- 当前格浅底：盖在染色层之上，让「现在」比同色系相邻格更亮 -->
                            <Border x:Name="CurrentFill" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource CurrentBackgroundBrush}" Visibility="Collapsed"/>

                            <!-- 2 发丝描边：同色 1px，透明度由 ChipLineOpacity 控制 -->
                            <Border x:Name="Edge" CornerRadius="{DynamicResource CardCornerRadius}"
                                    BorderThickness="1" BorderBrush="{Binding SubjectBrush}"
                                    Opacity="0" Visibility="Collapsed"/>

                            <!-- 3 左色条：平时略暗，hover / 当前才满格 -->
                            <Border x:Name="Bar" Width="2.5" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Margin="4,12,0,12"
                                    Background="{Binding SubjectBrush}" Opacity="0" Visibility="Collapsed"/>

                            <!-- 4 内容：科名（含色点）/ 备注 / 进行中 / 角标 -->
                            <StackPanel x:Name="Body" Margin="13,9,9,8" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding SubjectBrush}"/>
                                    <TextBlock x:Name="Name" Text="{Binding SubjectName}"
                                               FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource LabelBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="Meta" Text="{Binding MetaText}" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource Label3Brush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel x:Name="NowFlag" Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="Collapsed">
                                    <Ellipse Width="4" Height="4" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{x:Static core:WindowText.CURRENT_FLAG}"
                                               FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentDeepBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="Badge" Text="{Binding BadgeText}" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{DynamicResource Label3Brush}"
                                           Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <!-- 5 当前环：只在 IsCurrent 时出现，压在内容之上但不可命中 -->
                            <Border x:Name="Ring" CornerRadius="{DynamicResource CardCornerRadius}"
                                    BorderThickness="1" BorderBrush="{DynamicResource CurrentRingBrush}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>

                            <!-- 空格：悬停底色与「+」提示 -->
                            <Border x:Name="EmptyWash" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource HoverBrush}" Opacity="0" Visibility="Collapsed"/>
                            <TextBlock x:Name="Hint" Text="{x:Static core:WindowText.CELL_NEW_HINT}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       Foreground="{DynamicResource TextQuaternaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 有课：四层全部亮相 -->
                            <DataTrigger Binding="{Binding HasEntry}" Value="True">
                                <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tint" Property="Opacity" Value="{DynamicResource ChipTintOpacity}"/>
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Edge" Property="Opacity" Value="{DynamicResource ChipLineOpacity}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="{DynamicResource SubjectBarOpacity}"/>
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- 空格：只有悬停层，可点击 -->
                            <DataTrigger Binding="{Binding HasEntry}" Value="False">
                                <Setter TargetName="EmptyWash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- 当前：浅底 + 环 + 色条满格 + 科名转强调色 + 进行中标记 -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="CurrentFill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter TargetName="NowFlag" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AccentDeepBrush}"/>
                            </DataTrigger>

                            <!-- 已跳过：只弱化内容层，删去比伪造更诚实 -->
                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                <Setter TargetName="Body" Property="Opacity"
                                        Value="{x:Static core:UiConstants.GRID_SKIPPED_CONTENT_OPACITY}"/>
                                <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>

                            <!-- 悬停：单元格内元素变亮，不放投影（42 格用 Effect 会掉帧） -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasEntry}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Tint" Property="Opacity" Value="{DynamicResource ChipTintHoverOpacity}"/>
                                <Setter TargetName="Edge" Property="Opacity" Value="{DynamicResource ChipLineHoverOpacity}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </MultiDataTrigger>

                            <!-- 悬停：空格浮出淡底与「+」 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasEntry}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="EmptyWash" Property="Opacity" Value="1"/>
                                <Setter TargetName="Hint" Property="Opacity" Value="0.9"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- 外层 Grid 只为「今日列车道」提供一个定位坐标系：
             车道在 StackPanel 之前声明，天然位于行线与单元格之下。 -->
        <Grid x:Name="GridRoot">
            <Border x:Name="TodayLane"
                    Background="{DynamicResource TodayWashBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Visibility="Collapsed"/>

            <StackPanel>
                <!-- 表头：时刻列（固定宽）+ 周一…周日（等分）。
                     时间列用「固定宽度」而非共享尺寸组，表头与数据行取同一常量即可对齐。 -->
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static core:WindowText.TIME_COLUMN_HEADER}"
                               Width="{x:Static core:UiConstants.GRID_TIME_COLUMN_WIDTH}"
                               FontFamily="{StaticResource FontFamilyLabel}"
                               FontSize="{StaticResource FontSizeMicro}"
                               Foreground="{DynamicResource TextQuaternaryBrush}"
                               VerticalAlignment="Bottom"/>
                    <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding DayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 今天那一列：强调色胶囊底 + 主文字色（视觉稿 day-head.today） -->
                                <Border x:Name="Pill" Padding="10,4" CornerRadius="999"
                                        HorizontalAlignment="Center" Background="Transparent">
                                    <TextBlock x:Name="DayLabel" Text="{Binding Label}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource Label3Brush}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource LabelBrush}"/>
                                        <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerStrongBrush}"/>

                <!-- 数据行：一行 = 一个起始时刻 -->
                <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,7,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 时刻：等宽数字对齐；本行有「进行中」时加重（视觉稿 is-now） -->
                                    <TextBlock x:Name="RowTime" Grid.Column="0" Text="{Binding TimeText}"
                                               Width="{x:Static core:UiConstants.GRID_TIME_COLUMN_WIDTH}"
                                               FontFamily="{StaticResource FontFamilyNumeric}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource Label3Brush}"
                                               VerticalAlignment="Center"/>

                                    <ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource WeekCellButton}"
                                                        Command="{Binding ClickCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- 发丝行线：贯穿整行（含时刻列） -->
                                <Border Grid.Row="1" Background="{DynamicResource SepBrush}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsNow}" Value="True">
                                    <Setter TargetName="RowTime" Property="Foreground" Value="{DynamicResource LabelBrush}"/>
                                    <Setter TargetName="RowTime" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
