<Application x:Class="FuShi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:conv="clr-namespace:FuShi.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ============================================================
             浮时 · 设计令牌（来自 浮时-智能助手原型.html v5 定稿）
             表面：近黑不纯黑 · 文字：Apple 系统灰阶 · 强调色只给主操作
             ============================================================ -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#E816161C"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#F02C2C2E"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Label2Brush" Color="#A1A1A6"/>
        <SolidColorBrush x:Key="Label3Brush" Color="#7C7C81"/>
        <SolidColorBrush x:Key="SepBrush" Color="#38383A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A5B"/>

        <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

        <Style x:Key="AppTextBase" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- 布尔 → 可见性 转换器：折叠态要素的显隐全靠它 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 百分比 → 星号列权重 转换器：进度条填充/剩余两列靠它自适应 -->
        <conv:PercentToStarLengthConverter x:Key="PercentToStar"/>

        <!-- ============================================================
             托盘（H.NotifyIcon.Wpf）：声明式 TaskbarIcon。
             命令通过 DataContext 绑定到 TrayViewModel（App 启动时注入），
             图标由 TrayIconFactory 运行时绘制后赋给 Icon 属性。
             ============================================================ -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="显示 / 隐藏悬浮窗" Command="{Binding ToggleWidgetCommand}"/>
            <Separator/>
            <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
        </ContextMenu>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        ContextMenu="{StaticResource TrayMenu}"
                        DoubleClickCommand="{Binding ToggleWidgetCommand}"
                        NoLeftClickDelay="True"/>

    </Application.Resources>
</Application>
