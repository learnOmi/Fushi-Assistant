<Application x:Class="FuShi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:conv="clr-namespace:FuShi.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

        <!-- ============================================================
             设计令牌分三份（M3.5 实施计划 §3.3）：
             Shared.xaml 结构性、Light/Dark 主题、Controls 控件样式。
             主题字典不由 XAML 固定指定，而是由 ThemeService 在启动时
             插入到 MergedDictionaries 的索引 1（0=Shared，2=Controls），
             这样运行时切换只需替换槽位，其他字典索引不动。
             ============================================================ -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="UI/Themes/Shared.xaml"/>
            <ResourceDictionary Source="UI/Themes/Controls.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- 布尔 → 可见性 转换器：折叠态要素的显隐全靠它 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 百分比 → 星号列权重 转换器：进度条填充/剩余两列靠它自适应 -->
        <conv:PercentToStarLengthConverter x:Key="PercentToStar"/>

        <!-- ============================================================
             托盘（H.NotifyIcon.Wpf）：声明式 TaskbarIcon。
             命令通过 DataContext 绑定到 TrayViewModel（App 启动时注入），
             图标由 TrayIconFactory 运行时绘制后赋给 Icon 属性。
             ============================================================ -->
        <!--
            托盘右键菜单。StaysOpen 必须显式置 False：
            ContextMenu 的 StaysOpen 依赖属性「元数据默认值是 true」（与官方文档写的 false 不符），
            默认 true 时该菜单的 Popup 会保持打开、程序里置 IsOpen=false 及退出时都难以及时收起，
            于是出现「点退出后菜单仍赖在屏幕上几秒」的现象。
        -->
        <ContextMenu x:Key="TrayMenu" StaysOpen="False">
            <MenuItem Header="打开课表" Command="{Binding OpenMainWindowCommand}"/>
            <MenuItem Header="显示 / 隐藏悬浮窗" Command="{Binding ToggleWidgetCommand}"/>
            <Separator/>
            <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
        </ContextMenu>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        ContextMenu="{StaticResource TrayMenu}"
                        LeftClickCommand="{Binding OpenMainWindowCommand}"
                        NoLeftClickDelay="True"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
