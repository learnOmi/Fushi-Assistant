<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标框架带 Windows 版本：CommunityToolkit.WinUI.Notifications 的 ToastNotificationManagerCompat
         （非打包进程弹 Toast）只存在于 windows10.0.18362 及以上版本的资产里，故此处必须声明平台版本 -->
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 允许在 Linux/macOS 上交叉编译 Windows 目标（CI/沙箱构建用；运行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FuShi</AssemblyName>
    <RootNamespace>FuShi</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms 双开时移除 WinForms 隐式 global using，避免类型二义；
         WinForms 仅用于托盘 NotifyIcon，调用处全部全限定 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 噪点贴图打包进程序集，Shared.xaml 用 pack URI 引用（128×128 平铺，见 M3.5 §8.2 GrainOpacity） -->
    <Resource Include="Assets\noise.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuShi.Domain\FuShi.Domain.csproj" />
    <ProjectReference Include="..\FuShi.Infrastructure\FuShi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

</Project>
